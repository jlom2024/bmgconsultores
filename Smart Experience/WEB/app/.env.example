# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Variables de entorno para VPS Hostinger
# Copiar a .env.production y completar los valores reales.
# NUNCA commitear .env.production al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
APP_SLUG=bg-travel-peru

# ── Base de datos SQLite ──────────────────────────────────────────────────────
# Ruta absoluta recomendada en VPS
SQLITE_DB_PATH=/var/www/bg-travel/data/app.db

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Secreto para firmar/encriptar sesiones (mínimo 32 chars aleatorios)
# Generar con: openssl rand -hex 32
SESSION_SECRET=CAMBIAR_POR_SECRETO_SEGURO_32_CHARS_MINIMO

# ── Admin ─────────────────────────────────────────────────────────────────────
# Contraseña inicial del admin (se re-hashea en primer login)
# Cambiar inmediatamente después del primer despliegue
ADMIN_INITIAL_PASSWORD=CAMBIAR_ANTES_DE_DEPLOY

# ── Pagos Culqi ───────────────────────────────────────────────────────────────
# Obtener en https://panel.culqi.com/
CULQI_PUBLIC_KEY=pk_live_XXXXXXXXXXXXXXXX
CULQI_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXX

# ── WhatsApp Business API (opcional) ─────────────────────────────────────────
# Si se integra Meta WhatsApp Business API en lugar de wa.me links
# WA_ACCESS_TOKEN=
# WA_PHONE_NUMBER_ID=
# WA_VERIFY_TOKEN=

# ── Correo (opcional) ─────────────────────────────────────────────────────────
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=info@bgtravel.pe
# SMTP_PASS=
# SMTP_FROM="BG Travel Peru <info@bgtravel.pe>"
